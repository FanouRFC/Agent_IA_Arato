# Copier ce fichier en « .env » dans Backend_AgentIA (jamais committé).
APP_DATABASE_URL=postgresql+psycopg2://arato:arato@localhost:5432/arato_app
CRM_URL=http://localhost:8001
CRM_SERVICE_KEY=change-me-service-key
JWT_SECRET=change-me
ADMIN_EMAIL=responsable@arato.mg
ADMIN_PASSWORD=changeme

# development (défaut) ou production : en production, le backend REFUSE de démarrer si JWT_SECRET (16 caractères minimum),
# ADMIN_PASSWORD ou CRM_SERVICE_KEY gardent leur valeur d'exemple.
APP_ENV=development

# ───────── MODÈLE D'IA : LOCAL (Ollama, recommandé en production) ou EN LIGNE ─────────
# 0) LLM LOCAL avec Ollama — aucune clé, aucune donnée envoyée hors du serveur (cahier des charges, section « Contraintes »).
#    Installer Ollama, puis :  ollama pull llama3.1:8b   (ou qwen2.5:7b-instruct, mistral-nemo…)   et   ollama serve
#    Décommentez ces 4 lignes et mettez en commentaire le bloc « 1) Groq » ci-dessous :
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# LLM_TIMEOUT=300
#    Vérification : Administration → Modèle d'IA → « Tester la connexion » (serveur, modèle installé, génération réelle).
#
# Modèles en ligne (API externe compatible OpenAI) :
# La clé d'API se configure UNIQUEMENT ici (fichier .env du serveur) et n'est jamais affichée dans l'application.
# Le modèle actif se change ensuite depuis l'application : Administration > Modèle d'IA (liste des modèles disponibles).
# Choisissez UN bloc.

# 1) Groq — clé : https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=COLLEZ_VOTRE_CLE_ICI
LLM_MIN_INTERVAL=2.5

# 2) Google Gemini — clé : https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=COLLEZ_VOTRE_CLE_ICI
# LLM_MIN_INTERVAL=5
# LLM_MAX_DOC_CHARS=60000

# 3) OpenRouter — clé : https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=COLLEZ_VOTRE_CLE_ICI

LLM_TIMEOUT=120
LLM_MAX_RETRIES=4
# ───────── E-MAILS D'AFFECTATION ─────────
# Test local (aucun e-mail réel) : MAIL_SERVER=localhost, MAIL_PORT=1025 puis lancer_smtp_test.bat (affiche les e-mails à l'écran).
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_FROM=agent-ia@arato.mg
# Envoi RÉEL : décommentez et renseignez. Le chiffrement est choisi automatiquement (port 587 = STARTTLS, port 465 = SSL) :
#   Gmail   : MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  + mot de passe d'application (validation en 2 étapes requise)
#   Outlook : MAIL_SERVER=smtp.office365.com  MAIL_PORT=587
#   Brevo   : MAIL_SERVER=smtp-relay.brevo.com  MAIL_PORT=587
# MAIL_FROM doit être l'adresse du compte utilisé (ou une adresse autorisée par le fournisseur).
# MAIL_USERNAME=compte@exemple.mg
# MAIL_PASSWORD=mot_de_passe_application
# Facultatif : forcer le chiffrement (true / false) au lieu du mode automatique
# MAIL_STARTTLS=true
# MAIL_SSL_TLS=false
# Vérification : valider un cahier des charges puis lire le journal (Administration → Journal) : chaque e-mail y est indiqué « envoyé » ou « non envoyé » avec le motif.
# Chaque e-mail d'affectation est aussi archivé en .eml dans data/outbox (même si l'envoi échoue) ;
# le journal (Administration → Journal) indique, e-mail par e-mail, s'il est parti ou non.
HOLIDAYS=2026-11-01,2026-12-25,2027-01-01,2027-03-29,2027-05-01,2027-06-26,2027-08-15
WORK_DAY_END=17:00
SEUIL_JOURS=2
SEUIL_AVANCEMENT=50
EVENT_POLL_SECONDS=2
TEMPORAL_TICK_SECONDS=60
