# Copier ce fichier en « .env » dans Backend_AgentIA (jamais committé).
APP_DATABASE_URL=postgresql+psycopg2://arato:arato@localhost:5432/arato_app
CRM_URL=http://localhost:8001
CRM_SERVICE_KEY=change-me-service-key
JWT_SECRET=change-me
ADMIN_USERNAME=responsable
ADMIN_PASSWORD=changeme
# Fournisseur LLM = paramètre de configuration (Ollama local par défaut ; toute API compatible OpenAI)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_FROM=agent-ia@arato.mg
